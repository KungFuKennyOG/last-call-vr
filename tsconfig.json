{
  // Type checks the plain-JS modules through JSDoc. Nothing is compiled or emitted: the browser runs the files as written.
  // The games' page scripts (index.html, showdowns/index.html) are inline and not covered; their shared code lives in the module folders below.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["types", "engine", "actors", "combat", "fx", "audio", "drop", "dev"]
}
